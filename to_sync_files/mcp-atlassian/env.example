# Copy this file to ~/.config/mcp-atlassian/env and fill in real values.
# That file holds API tokens and must never be committed.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://<site>.atlassian.net
JIRA_USERNAME=<email>
JIRA_API_TOKEN=<token>
CONFLUENCE_URL=https://<site>.atlassian.net/wiki
CONFLUENCE_USERNAME=<email>
CONFLUENCE_API_TOKEN=<token>
ALLOW_GLOBAL_CRED_FALLBACK=true
